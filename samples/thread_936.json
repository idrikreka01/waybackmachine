        "post_content_html": "<blockquote class=\"postcontent restore \">\n\t\t\t\t\t\t\t<div class=\"bbcode_container\">\n\t<div class=\"bbcode_quote\">\n\t\t<div class=\"quote_container\">\n\t\t\t<div class=\"bbcode_quote_container\"></div>\n\t\t\t\n\t\t\t\t<div class=\"bbcode_postedby\">\n\t\t\t\t\t<img src=\"http://www.fullsizechevy.com/forum/images/styles/gametime_red/misc/quote_icon.png\" alt=\"Quote\" title=\"Quote\"> Originally Posted by <strong>Kick</strong>\n\t\t\t\t\t<a href=\"http://www.fullsizechevy.com/forum/image-gallery/snapshots-videos/478693-before-after-thread.html#post5351971\" rel=\"nofollow\"><img class=\"inlineimg\" src=\"http://www.fullsizechevy.com/forum/images/styles/gametime_red/buttons/viewpost-right.png\" alt=\"View Post\" title=\"View Post\"></a>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"message\"><img src=\"http://i103.photobucket.com/albums/m154/d_fisch77/DSC_0203.jpg\" border=\"0\" alt=\"\" onload=\"NcodeImageResizer.createOn(this);\"><br>\n<br>\nand now<br>\n<br>\n<img src=\"http://i103.photobucket.com/albums/m154/d_fisch77/IMG_0037.jpg\" border=\"0\" alt=\"\" onload=\"NcodeImageResizer.createOn(this);\"></div>\n\t\t\t\n\t\t</div>\n\t</div>\n</div> debadge and demold<br>\n<br>\n<br>\n<br>\n<br>\n<img src=\"http://www.fullsizechevy.com/forum/images/smilies/looking.gif\" border=\"0\" alt=\"\" title=\"looking\" class=\"inlineimg\">\n\t\t\t\t\t\t</blockquote>"
